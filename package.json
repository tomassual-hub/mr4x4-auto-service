{
  "name": "mr4x4-auto-service",
  "version": "1.0.0",
  "private": true,
  "description": "Mr 4x4 Auto Service — workshop management PWA",
  "scripts": {
    "build": "node build/build.js",
    "build:test": "node build/build-test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
