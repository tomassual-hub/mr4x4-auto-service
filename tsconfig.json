{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "module": "none",
    "moduleDetection": "force"
  },
  "include": ["src/**/*.js", "src/global.d.ts"],
  "exclude": ["src/service-worker.js"]
}
